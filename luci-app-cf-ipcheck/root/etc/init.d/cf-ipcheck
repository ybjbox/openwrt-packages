#!/bin/sh /etc/rc.common
# cf-ipcheck 常驻：按 interval_hours 循环跑一轮。
#
# 为什么用常驻循环而不是往 /etc/crontabs/root 里塞条目：
#   1) 不与他人（autoreboot 等）共享的 crontab 互相覆盖；
#   2) 改完 UCI 下一轮自然生效（daemon 分支每轮重新 load_config），不需要重启服务。
#
# r41 起这个循环带周期守门：距上一次【起轮】不满 interval_hours 就不跑。
# 于是「保存并应用」（procd 的 reload 触发 = stop+start）和「设备重启」都不再莫名
# 多吃一轮 —— 真机一轮约 104.86MB。要立刻测就在页面上点「立即测速」（或直接 cf-ipcheck run-now）。
# 注意这条守门同样作用于「把总开关从关翻到开」：上一轮还在周期内时不会立刻起轮。
# 这是有意的 —— 榜单本来就是十几分钟前的数据；真想重来一轮就走手动入口。

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/cf-ipcheck daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger cf_ipcheck
}
