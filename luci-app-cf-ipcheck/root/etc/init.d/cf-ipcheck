#!/bin/sh /etc/rc.common
# cf-ipcheck 常驻：按 interval_hours 循环跑一轮。
#
# 为什么用常驻循环而不是往 /etc/crontabs/root 里塞条目：
#   1) 不与他人（autoreboot 等）共享的 crontab 互相覆盖；
#   2) 改完 UCI 下一轮自然生效（daemon 分支每轮重新 load_config），不需要重启服务。
# 关掉 enabled 时只 sleep 60 空转，因此 LuCI 里打开开关一分钟内就会开始测。

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/cf-ipcheck daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger cf_ipcheck
}
