#!/bin/sh /etc/rc.common
# cf-ipcheck 常驻：按 interval_hours 循环跑一轮。
#
# 为什么用常驻循环而不是往 /etc/crontabs/root 里塞条目：
#   1) 不与他人（autoreboot 等）共享的 crontab 互相覆盖；
#   2) 改完 UCI 下一轮自然生效（daemon 分支每轮重新 load_config），不需要重启服务。
#
# r41 起这个循环带周期守门：距上一次【起轮】不满 interval_hours 就不跑。
# 于是「保存并应用」（r205 起 reload 只是空操作，见文件末尾）和「设备重启」都不再
# 莫名多吃一轮 —— 真机一轮约 180MB。要立刻测就在页面上点「立即测速」（或直接 cf-ipcheck run-now）。
# 注意这条守门同样作用于「把总开关从关翻到开」：上一轮还在周期内时不会立刻起轮。
# 这是有意的 —— 榜单本来就是十几分钟前的数据；真想重来一轮就走手动入口。

START=99
STOP=10
USE_PROCD=1

start_service() {
	# /etc/config/cf_ipcheck 里有 gist_token / dns_token 明文。apk 解包按 umask 022
	# 出来就是 0644 —— 同机任何用户（包括插件自己的探测身份 nobody）都能读。
	# uci commit 会保留原文件的权限位（真机验过 0644 → 0644），所以只要在这里压一次
	# 就一直是 600，不用每次保存都管。uci-defaults 里另有一份，覆盖"装完还没重启服务"。
	chmod 600 /etc/config/cf_ipcheck 2>/dev/null || true
	procd_open_instance
	procd_set_param command /usr/bin/cf-ipcheck daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# 「保存并应用」不再重启服务（r205）。
	#
	# 以前这里是 stop + start：procd 收到 config.change 就把常驻进程掐掉重开，而
	# 一轮测速要跑三分半、吃掉约 100MB —— 正在跑的会被打断，页面上的「本轮中断」
	# 有相当一部分就是这么来的。引擎本来就每 60 秒重读一次配置（daemon 分支每片
	# 都跑 load_config），改完最迟一分钟就按新参数走，重启纯属多余。
	#
	# 但不能一律空操作：procd 的 config.change 也是「服务被停掉后重新拉起」的
	# 唯一路径（System → 启动项里先禁用再启用就是这个流程），空实现会让它一直
	# 躺着。所以只在没在跑的时候 start（start 自己会按 enabled 判断该不该起）。
	#
	# 判进程不用 pgrep -f：它会连承载这条命令的 ash 包装进程一起匹配上，永远为真。
	if ps w 2>/dev/null | grep -q "[c]f-ipcheck daemon"; then
		return 0
	fi
	start
}

service_triggers() {
	procd_add_reload_trigger cf_ipcheck
}
