config global 'global'
	# 总开关：关掉时 daemon 空转不测速
	option enabled '0'

	# 定时周期（小时）
	option interval_hours '6'

	# 探测目标域名，逗号分隔。必须是真正解析到 Cloudflare 后面的域名，
	# 否则 --resolve 指到 CF IP 上拿不到正常响应。
	option probe_domains 'www.cloudflare.com'

	# 探测端口
	option probe_port '443'

	# 候选池来源
	# 默认只吃社区优选列表（下面那组），不再把官方网段按 /24 铺成近六千个候选。
	# 想要更大覆盖面就把 use_official_ranges 打开，官方段会抽稀填满剩余名额。
	option use_official_ranges '0'   # api.cloudflare.com/client/v4/ips 的网段（按 /24 采样）
	option reuse_last '1'            # 把上一轮入围 IP 带回候选池
	# 社区源只是"别人替你挑出来的种子"，好坏仍以本机实测为准；
	# 每条都要求提取到的 IPv4 绝大多落在 Cloudflare 官方段内（2026-09-27 逐个
	# 用 api.cloudflare.com/client/v4/ips 核过比例，见 README）。
	list community_sources 'https://bestcf.pages.dev/entryip/50.txt'
	list community_sources 'https://bestcf.pages.dev/cfyes/ipv4.txt'
	list community_sources 'https://bestcf.pages.dev/wetest/ipv4.txt'
	list community_sources 'https://bestcf.pages.dev/ircf/ipv4.txt'
	list community_sources 'https://bestcf.pages.dev/nirevil/ipv4.txt'
	list community_sources 'https://raw.githubusercontent.com/ymyuuu/IPDB/main/BestCF/bestcfv4.txt'
	list community_sources 'https://raw.githubusercontent.com/hubbylei/bestcf/main/bestcf.txt'
	list community_sources 'https://raw.githubusercontent.com/gslege/CloudflareIP/main/All.txt'
	list community_sources 'https://raw.githubusercontent.com/XIU2/CloudflareSpeedTest/master/ip.txt'

	# 池子与并发
	option candidate_budget '256'    # 单轮最多探测多少个 IP
	option concurrency '8'
	option probe_timeout '5'

	# 判定与排序阈值（毫秒）：total 与 ttfb 双门槛，都过才算达标
	option ttfb_limit '3000'
	option total_limit '5000'
	option keep_count '10'

	# 只给入围 IP 查落地机房（cdn-cgi/trace 的 colo=），多一轮请求
	option colo_probe '1'

	# 出口接管自检：每轮先用 RFC 5737 保留地址探一次。保留地址本该连不上，
	# 一旦它返回任何 HTTP 状态码，说明本机 443 被 OpenClash 之类透明代理接管，
	# --resolve 钉的 IP 没参与选路，本轮榜单数字不可信（页面会红条提示）。
	option canary_check '1'

	# 探测用哪个身份发起。默认 nobody：OpenClash 的 mangle 链第一条就是
	# `meta skgid 65534 ... return`，用 nobody 跑探测正好绕过接管，量到的才是
	# 候选 IP 本身（root 直发会被代理接管，connect 恒为 0.000x 秒）。
	# 留空则退回 root 直发。
	option probe_user 'nobody'

	# ip.txt 注释模板，可用占位符 {colo} {total}
	option annotate 'cf-ipcheck | {colo} | {total}ms'

	# Gist 上传。token 不放这里的任何字段，只填文件路径，
	# 由 `cf-ipcheck` 之外的方式写入该文件并 chmod 600。
	option upload_gist '0'
	option gist_id ''
	option gist_file 'cf-ip.txt'
	option token_file '/etc/cf-ipcheck.token'
