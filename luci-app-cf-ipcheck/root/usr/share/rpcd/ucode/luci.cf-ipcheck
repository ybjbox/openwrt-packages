// rpcd ucode 插件：把 /usr/bin/cf-ipcheck 的几个子命令包成**具名方法**。
//
// 为什么要这一层，而不是让页面直接 rpcd file.exec 那个脚本：
//   file.exec 的 ACL 语义是「允许用任意参数执行这个绝对路径」（真机现在的写法），
//   而这里收窄成「只能调 methods 表里的方法」—— 能做什么由下面这张表决定，
//   不由请求方决定。树内带逻辑的应用（upnp / ddns / wol / mosdns）都走这条路，
//   file.exec 留给固定的一次性命令。
//
// 为什么不把引擎输出的 JSON 在这里 parse 成 blobmsg 再回给页面：
//   那份 JSON 的字段契约属于引擎（result.json / status.json 的键），在 ucode 里
//   再抄一份就等于同一份契约有两个出处 —— 正是 lint red-line-6 防的那类漂移。
//   所以这里只回 { text: "引擎原样输出" }，解析留在视图那一层。
//
// 装完要注意：rpcd 是在启动时加载 /usr/share/rpcd/ucode/ 下的脚本的，
// 新装/更新这个文件后必须重启 rpcd 才生效（本包的 postinst 负责这件事）。
'use strict';

import { popen } from 'fs';

const CMD = '/usr/bin/cf-ipcheck';

/* 跑一条固定的子命令，把它 stdout 的整份内容原样带回。
 * 子命令是写死的字面量，任何一段都不来自请求方 —— 这里没有拼接外部输入的地方。
 * 必须把管道读到尽头再 close：rpcd 会等这条 popen 的 EOF，留着一根没读完的
 * 管道就等于把整个请求挂住（引擎侧 run-now 已经自己关掉继承的 fd，见该分支注释）。
 *
 * 失败时 text 必须是 **null** 而不是空串：视图把「空串」解释成「引擎跑完了但没有结果」
 * （也就是从未跑过一轮），而 popen 起不来是「压根没执行成」—— 两者混起来的话，
 * 页面会在引擎根本没启动的情况下说「已启动一轮测速」（绿色的假成功）。 */
function sh(sub) {
	const h = popen(CMD + ' ' + sub + ' 2>/dev/null');

	if (!h)
		return { ok: false, text: null };

	let out = '';
	const all = h.read('all');

	if (all != null)
		out = all;

	h.close();

	return { ok: true, text: trim(out) };
}

/* rpcd 的 ucode 沙箱里正则字面量会抛异常（r146 真机实测：方法直接 Unknown error），
 * 这里用逐字符校验。只用于挡住命令拼接；八位段的范围仍由引擎 valid_ip4 再判。 */
function ip4ok(s) {
	if (length(s) < 7 || length(s) > 15)
		return false;
	for (let i = 0; i < length(s); i++) {
		const c = substr(s, i, 1);
		if (c != '.' && (c < '0' || c > '9'))
			return false;
	}
	return true;
}

function digitsok(s) {
	if (length(s) < 1 || length(s) > 5)
		return false;
	for (let i = 0; i < length(s); i++) {
		const c = substr(s, i, 1);
		if (c < '0' || c > '9')
			return false;
	}
	return true;
}

const methods = {
	status: {
		call: () => sh('status')
	},
	logs: {
		call: () => sh('logs')
	},
	run: {
		call: () => sh('run-now')
	},
	stop: {
		call: () => sh('stop')
	},
	check_sources: {
		call: () => sh('check-sources')
	},
	// 单源检测：只接受已保存源清单里的序号，URL 由引擎按自己的列表取，
	// 页面递不进任意地址（也避免把 URL 拼进 shell）。
	check_source: {
		args: { index: 'index' },
		call: (request) => {
			const index = (request.args && request.args.index) ? '' + request.args.index : '';
			if (!digitsok(index))
				return { ok: false, text: null };
			return sh('check-source ' + index);
		}
	},
	// DNS 同步（可选功能）：把榜首写进 Cloudflare 的 A 记录。
	// 单独成一个方法而不是复用 run：它的语义是「现在就写一次」，与「跑一轮」无关，
	// 而且它不联网测速、只发两三次 API 请求，超时预算完全不同。
	dns_sync: {
		call: () => sh('dns-sync')
	},
	// 三个只读出口（r98 P1-2/3/4）。引擎里本来就有这三个子命令，之前只存在于 ssh。
	//   csv  —— CFST 口径的七列 CSV，页面用它做「下载 CSV」
	//   diag —— 引擎实际读到的配置快照，页面用它做「诊断摘要」
	//   pool —— 本轮候选池（联网取源、不测速），页面用它做「候选池预览」
	// 都是纯读：不写配置、不写日志、不改系统。pool 唯一会联网（去拉源），
	// 但拉源本来就是只读动作 —— 源的内容是外部给的事实，不是本机状态。
	csv: {
		call: () => sh('csv')
	},
	diag: {
		call: () => sh('diag')
	},
	pool: {
		call: () => sh('pool')
	},
	// 单 IP 复测（机房明细里的「延迟 / 测速」）。参数只有严格 IPv4 与 mode；
	// 域名、端口、样本大小全部由引擎按已保存配置取，页面递不进来。
	test_ip: {
		args: { ip: 'ip', mode: 'mode' },
		call: (request) => {
			const ip = (request.args && request.args.ip) ? '' + request.args.ip : '';
			const mode = (request.args && request.args.mode) ? '' + request.args.mode : '';
			if (!ip4ok(ip) || (mode != 'delay' && mode != 'speed'))
				return { ok: false, text: null };
			return sh('test-ip ' + ip + ' ' + mode);
		}
	}
};

return { 'luci.cf-ipcheck': methods };
