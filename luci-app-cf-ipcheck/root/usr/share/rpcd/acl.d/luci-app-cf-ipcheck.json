{
    "luci-app-cf-ipcheck": {
        "description": "Grant access to cf-ipcheck (exec only) and its UCI config",
        "read": {
            "file": {
                "/usr/bin/cf-ipcheck": [
                    "exec"
                ]
            },
            "uci": [
                "cf_ipcheck"
            ]
        },
        "write": {
            "uci": [
                "cf_ipcheck"
            ]
        }
    }
}
