{
    "luci-app-cf-ipcheck": {
        "description": "Grant access to the cf-ipcheck ucode RPC methods and its UCI config",
        "read": {
            "ubus": {
                "luci.cf-ipcheck": [
                    "status",
                    "logs",
                    "check_sources",
                    "check_source",
                    "csv",
                    "diag",
                    "pool"
                ]
            },
            "uci": [
                "cf_ipcheck"
            ]
        },
        "write": {
            "ubus": {
                "luci.cf-ipcheck": [
                    "run",
                    "stop",
                    "dns_sync",
                    "test_ip"
                ]
            },
            "uci": [
                "cf_ipcheck"
            ]
        }
    }
}
