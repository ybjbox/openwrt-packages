{
  "luci-app-nav": {
    "description": "Grant NAV collector UCI read/write, service status read, and service restart",
    "read": {
      "uci": [ "nav" ],
      "ubus": {
        "service": [ "list" ]
      }
    },
    "write": {
      "uci": [ "nav" ],
      "ubus": {
        "luci": [ "setInitAction" ]
      }
    }
  }
}
